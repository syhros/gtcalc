# Firebase web config (Firebase console > Project settings > Your apps). Not secret: access is
# controlled by firestore.rules. Copy to .env.local for development; set the same in Vercel.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Optional: reCAPTCHA v3 site key for Firebase App Check (blocks requests from outside the site).
VITE_RECAPTCHA_SITE_KEY=

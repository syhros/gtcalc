rules_version = '2';

// gtcalc: who may read and write what. These rules are the security boundary: the web app,
// a script or the browser console all go through them, so every write is checked here for its
// owner, exact fields, types, sizes, banned words and rate limits.
//
// Public: builds, comments, profiles (username + join date), username claims.
// Private: each user's saved flows (users/{uid}/flows) and rate-limit stamps.
// Moderators only: username reviews and the list of denied names (never readable by users;
// the claim rule checks it without revealing it). Moderators are added with the admin login.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    // A voter list may only gain or lose the caller's own uid, one entry at a time.
    function ownToggle(field) {
      let before = resource.data[field];
      let after = request.resource.data[field];
      return after is list
          && ((after.size() == before.size() + 1 && after.hasAll(before) && after.hasAny([me()]) && !before.hasAny([me()]))
          || (after.size() == before.size() - 1 && before.hasAll(after) && before.hasAny([me()]) && !after.hasAny([me()])));
    }
    function myUsername() { return get(/databases/$(database)/documents/users/$(me())).data.username; }
    function isMod() { return signedIn() && exists(/databases/$(database)/documents/mods/$(me())); }
    function profile() { return /databases/$(database)/documents/users/$(me()); }
    // A moderator asked this account to pick a new username (kept private: only the owner and
    // moderators can read renameFlags).
    function flagged() { return exists(/databases/$(database)/documents/renameFlags/$(me())); }

    // Banned words: slurs, hate terms and severe profanity, including look-alike spellings
    // (n1gg3r, fuuuck). Same list as src/moderation.ts; generated by scripts/rules-blocklist.py.
    function clean(t) {
      let s = t.lower();
      return !s.matches('(?s).*(n+[i1!|]+[g9]+[g9]+[e3]+r+|n+[i1!|]+[g9]+[g9]+[a4@]+|f+[a4@]+[g9]+[g9]+[o0]+[t7+]+|k+[i1!|]+k+[e3]+|w+[e3]+[t7+]+[b8]+[a4@]+c+k+|[t7+]+r+[a4@]+n+n+y+|r+[a4@]+[g9]+h+[e3]+[a4@]+d+|[t7+]+[o0]+w+[e3]+l+h+[e3]+[a4@]+d+|[b8]+[e3]+[a4@]+n+[e3]+r+|f+u+c+k+|[b8]+u+l+l+[s5$]+h+[i1!|]+[t7+]+|[s5$]+h+[i1!|]+[t7+]+h+[e3]+[a4@]+d+|[s5$]+h+[i1!|]+[t7+]+[t7+]+y+|w+h+[o0]+r+[e3]+|[s5$]+l+u+[t7+]+|[b8]+[i1!|]+[t7+]+c+h+|h+[i1!|]+[t7+]+l+[e3]+r+|k+[i1!|]+l+l+y+[o0]+u+r+[s5$]+[e3]+l+f+|p+[a4@]+[e3]+d+[o0]+|p+[e3]+d+[o0]+p+h+[i1!|]+l+|m+[o0]+l+[e3]+[s5$]+[t7+]+|k\\W*k\\W*k).*')
        && !s.matches('(?s)(.*[^a-z0-9])?(n+[a4@]+z+[i1!|]+|n+[a4@]+z+[i1!|]+[s5$]+|[s5$]+h+[i1!|]+[t7+]+|r+[e3]+[t7+]+[a4@]+r+d+|r+[e3]+[t7+]+[a4@]+r+d+[e3]+d+|c+h+[i1!|]+n+k+|[s5$]+p+[i1!|]+c+|c+[o0]+[o0]+n+|[g9]+[o0]+[o0]+k+|p+[a4@]+k+[i1!|]+|d+y+k+[e3]+|c+u+n+[t7+]+|r+[a4@]+p+[e3]+|r+[a4@]+p+[i1!|]+[s5$]+[t7+]+|p+[e3]+d+[o0]+|k+y+[s5$]+|[a4@]+[s5$]+[s5$]+|[a4@]+r+[s5$]+[e3]+|f+[a4@]+[g9]+|c+u+m+|d+[i1!|]+c+k+|c+[o0]+c+k+|[t7+]+w+[a4@]+[t7+]+|w+[a4@]+n+k+|j+[i1!|]+z+z+|p+[o0]+r+n+|[s5$]+[e3]+x+|[a4@]+n+[a4@]+l+|[t7+]+[i1!|]+[t7+]+[s5$]+)([^a-z0-9].*)?');
    }

    // Rate limits: the caller's own stamp, set to the server time in the same write.
    function limits() { return /databases/$(database)/documents/limits/$(me()); }
    function stampedNow(field) { return getAfter(limits()).data[field] == request.time; }
    function waited(field, seconds) {
      return !exists(limits()) || !(field in get(limits()).data)
        || request.time > get(limits()).data[field] + duration.value(seconds, 's');
    }

    match /limits/{uid} {
      allow read: if signedIn() && uid == me();
      // Only ever set to "now", so a stamp can't be wound back; never deleted.
      // Each stamp also names the one build / comment it was written with, so a single batch
      // can't slip several past the rate limit.
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['lastComment', 'lastCommentId', 'lastBuild', 'lastBuildId'])
        && (!('lastComment' in request.resource.data) || request.resource.data.lastComment == request.time)
        && (!('lastBuild' in request.resource.data) || request.resource.data.lastBuild == request.time)
        && (!('lastCommentId' in request.resource.data) || str(request.resource.data.lastCommentId, 3, 200))
        && (!('lastBuildId' in request.resource.data) || str(request.resource.data.lastBuildId, 3, 200));
      allow update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['lastComment', 'lastCommentId', 'lastBuild', 'lastBuildId'])
        && (!('lastComment' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lastComment == request.time)
        && (!('lastBuild' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lastBuild == request.time)
        // An id only changes together with its time stamp.
        && (!('lastCommentId' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lastComment == request.time)
        && (!('lastBuildId' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lastBuild == request.time);
      allow delete: if signedIn() && uid == me(); // deleting the account
    }

    // Username claims: one per name, created once by the owner at sign-up, or again when a
    // moderator has flagged the old name (the old claim goes and the profile follows, in one batch).
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'hasEmail', 'loginAs'])
        && request.resource.data.uid == me()
        && request.resource.data.hasEmail is bool
        && request.resource.data.username.matches('^[A-Za-z0-9_-]{3,20}$')
        && name == request.resource.data.username.lower()
        && clean(request.resource.data.username)
        && !exists(/databases/$(database)/documents/bannedNames/$(name)) // denied by a moderator
        // Accounts without an email sign in with an address made from their first username.
        && (!('loginAs' in request.resource.data) || request.resource.data.loginAs.matches('^[a-z0-9_-]{3,20}$'))
        // One username per account: a new account, or a flagged one renaming (its profile takes this name).
        && (!exists(profile()) || (flagged() && getAfter(profile()).data.username == request.resource.data.username));
      allow update: if signedIn() && resource.data.uid == me() && onlyChanged(['hasEmail']) && request.resource.data.hasEmail is bool;
      // Releasing a flagged name, or the account is being deleted (its profile goes in the same batch).
      allow delete: if signedIn() && resource.data.uid == me() && (flagged() || !existsAfter(profile()));
    }

    // Moderators: written only with the admin login. Each can see that they are one.
    match /mods/{uid} {
      allow read: if signedIn() && uid == me();
      allow write: if false;
    }

    // Names a moderator denied: nobody can claim them; only moderators can see or change the list.
    match /bannedNames/{name} {
      allow read, delete: if isMod();
      allow create: if isMod()
        && request.resource.data.keys().hasOnly(['username', 'by', 'at'])
        && str(request.resource.data.username, 3, 20)
        && request.resource.data.by == me()
        && request.resource.data.at == request.time;
    }

    // Reports on shared flows: one per person per flow (reporting again replaces it). Only
    // moderators can read them.
    match /reports/{reportId} {
      allow read, delete: if isMod();
      allow create, update: if signedIn()
        && reportId == request.resource.data.buildId + '_' + me()
        && request.resource.data.keys().hasOnly(['buildId', 'buildName', 'reason', 'info', 'by', 'at'])
        && exists(/databases/$(database)/documents/builds/$(request.resource.data.buildId))
        && str(request.resource.data.buildName, 1, 64)
        && request.resource.data.reason in ['offensive', 'spam', 'copied', 'broken', 'other']
        && str(request.resource.data.info, 0, 500)
        && request.resource.data.by == me()
        && request.resource.data.at == request.time;
    }

    // Reports on comments: one per person per comment; only moderators can read them.
    match /commentReports/{reportId} {
      allow read, delete: if isMod();
      allow create, update: if signedIn()
        && reportId == request.resource.data.buildId + '_' + request.resource.data.commentId + '_' + me()
        && request.resource.data.keys().hasOnly(['buildId', 'commentId', 'buildName', 'commentText', 'commentAuthor', 'reason', 'info', 'by', 'at'])
        && str(request.resource.data.buildId, 1, 200) && str(request.resource.data.commentId, 1, 64)
        && exists(/databases/$(database)/documents/builds/$(request.resource.data.buildId)/comments/$(request.resource.data.commentId))
        && str(request.resource.data.buildName, 1, 64) && str(request.resource.data.commentText, 1, 1000) && str(request.resource.data.commentAuthor, 1, 20)
        && request.resource.data.reason in ['offensive', 'spam', 'copied', 'broken', 'other']
        && str(request.resource.data.info, 0, 500)
        && request.resource.data.by == me()
        && request.resource.data.at == request.time;
    }

    // "Pick a new username": set by a moderator, readable only by the account and moderators.
    // The owner removes it by renaming (profile username changes in the same batch) or by
    // deleting the account.
    match /renameFlags/{uid} {
      allow read: if signedIn() && (uid == me() || isMod());
      allow create: if isMod() && request.resource.data.keys().hasOnly(['by', 'at'])
        && request.resource.data.by == me() && request.resource.data.at == request.time;
      allow delete: if isMod() || (signedIn() && uid == me()
        && (!existsAfter(profile()) || getAfter(profile()).data.username != get(profile()).data.username));
    }

    // Modpacks people want added: one document per pack, with who asked for it. Users can only
    // add or take back their own vote (they can't read the list); moderators read and clear it.
    match /packSuggestions/{packId} {
      allow read, delete: if isMod();
      allow create: if signedIn() && packId.matches('[a-z0-9-]{1,64}')
        && request.resource.data.keys().hasOnly(['name', 'url', 'source', 'voters', 'createdAt'])
        && str(request.resource.data.name, 1, 80) && clean(request.resource.data.name)
        && str(request.resource.data.url, 8, 300) && request.resource.data.url.matches('https://[^ ]+')
        && request.resource.data.source in ['modrinth', 'curseforge', 'link']
        && request.resource.data.voters == [me()]
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && onlyChanged(['voters']) && ownToggle('voters');
    }

    // A moderator's decision on a shared flow's name and description (re-checked if they change).
    match /flowReviews/{buildId} {
      allow read, delete: if isMod();
      allow create, update: if isMod()
        && request.resource.data.keys().hasOnly(['name', 'description', 'decision', 'by', 'at'])
        && request.resource.data.name is string && request.resource.data.description is string
        && request.resource.data.decision == 'allowed'
        && request.resource.data.by == me()
        && request.resource.data.at == request.time;
    }

    // A moderator's decision on a username (one per account, replaced when they decide again).
    match /reviews/{uid} {
      allow read, delete: if isMod();
      allow create, update: if isMod()
        && request.resource.data.keys().hasOnly(['username', 'decision', 'score', 'reason', 'by', 'at'])
        && str(request.resource.data.username, 3, 20)
        && request.resource.data.decision in ['allowed', 'denied']
        && request.resource.data.score is number
        && request.resource.data.reason is string
        && request.resource.data.by == me()
        && request.resource.data.at == request.time;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['username', 'createdAt'])
        && request.resource.data.createdAt == request.time
        // Written in the same batch as the username claim, so check the state after the batch.
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower()))
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == me();
      allow update: if signedIn() && (
        // Moderators clear the old public flag field (it now lives in renameFlags).
        (isMod() && onlyChanged(['flagged']) && !('flagged' in request.resource.data))
        // A flagged user picks a new name, claimed in the same batch; the flag goes with it.
        || (uid == me() && flagged()
            && request.resource.data.keys().hasOnly(['username', 'createdAt'])
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.username != resource.data.username
            && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == me())
      );
      allow delete: if signedIn() && uid == me(); // deleting the account

      // Saved flows are private to their owner.
      match /flows/{flowId} {
        allow read, delete: if signedIn() && uid == me();
        allow create, update: if signedIn() && uid == me()
          && (resource == null || request.resource.data.savedAt >= resource.data.savedAt) // never overwrite a newer copy
          && request.resource.data.keys().hasOnly(['name', 'savedAt', 'draft', 'json', 'pack'])
          && str(request.resource.data.name, 0, 64)
          && request.resource.data.savedAt is number
          && request.resource.data.draft is bool
          && str(request.resource.data.json, 2, 900000)
          && str(request.resource.data.pack, 1, 40);
      }
    }

    // One claim per exact flow (nodes + links), created with its build; the build's author
    // can release it by deleting the build.
    match /fingerprints/{fp} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'buildId'])
        && request.resource.data.uid == me()
        // For a new build its id is <uid>_<fp>; an updated build keeps its id and claims the new fp.
        && ((request.resource.data.buildId == me() + '_' + fp
             && existsAfter(/databases/$(database)/documents/builds/$(me() + '_' + fp)))
          || (request.resource.data.buildId.matches(me() + '_[0-9a-f]{24}')
             && get(/databases/$(database)/documents/builds/$(request.resource.data.buildId)).data.authorId == me()));
      allow update: if false;
      allow delete: if signedIn() && (resource.data.uid == me() || isMod());
    }

    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    match /builds/{buildId} {
      allow read: if true;
      allow create: if signedIn()
        // The id is <uid>_<flow fingerprint>: one build per flow, and an existing one can't be overwritten.
        && buildId.matches(me() + '_[0-9a-f]{24}')
        && getAfter(/databases/$(database)/documents/fingerprints/$(buildId.split('_')[1])).data.uid == me()
        && request.resource.data.keys().hasOnly(['name', 'description', 'author', 'authorId', 'pack', 'createdAt', 'flowJson', 'stats', 'schematicName', 'sourceFlowId', 'tag', 'upvoters', 'favoriters', 'commentCount'])
        && (!('tag' in request.resource.data) || request.resource.data.tag in ['power', 'fuel', 'chemicals', 'metals', 'early'])
        && request.resource.data.authorId == me()
        && request.resource.data.author == myUsername()
        && request.resource.data.createdAt == request.time
        && str(request.resource.data.name, 1, 64) && clean(request.resource.data.name)
        && str(request.resource.data.description, 0, 2000) && (request.resource.data.description == '' || clean(request.resource.data.description))
        && str(request.resource.data.pack, 1, 40)
        && str(request.resource.data.flowJson, 2, 900000)
        && request.resource.data.stats is map
        && request.resource.data.stats.keys().hasOnly(['machines', 'topTier', 'lowTier', 'eutUse', 'eutGen', 'output'])
        && request.resource.data.stats.machines is number && request.resource.data.stats.eutUse is number && request.resource.data.stats.eutGen is number
        && str(request.resource.data.stats.topTier, 1, 8) && str(request.resource.data.stats.lowTier, 1, 8)
        && (!('output' in request.resource.data.stats) || (request.resource.data.stats.output is map
            && str(request.resource.data.stats.output.id, 1, 200) && str(request.resource.data.stats.output.name, 1, 200)))
        && (!('schematicName' in request.resource.data) || str(request.resource.data.schematicName, 1, 100))
        && (!('sourceFlowId' in request.resource.data) || str(request.resource.data.sourceFlowId, 1, 80))
        && request.resource.data.upvoters == [] && request.resource.data.favoriters == []
        && request.resource.data.commentCount == 0
        && stampedNow('lastBuild') && waited('lastBuild', 60)
        && getAfter(limits()).data.lastBuildId == buildId;
      allow update: if signedIn() && (
        (onlyChanged(['upvoters']) && ownToggle('upvoters'))
        || (onlyChanged(['favoriters']) && ownToggle('favoriters'))
        // Copies: each person adds their own uid once (never removed), so the count can't be pumped.
        || (onlyChanged(['forkers']) && request.resource.data.forkers is list
            && request.resource.data.forkers.size() == resource.data.get('forkers', []).size() + 1
            && request.resource.data.forkers.hasAll(resource.data.get('forkers', []))
            && request.resource.data.forkers.hasAny([me()]) && !resource.data.get('forkers', []).hasAny([me()])
            && resource.data.get('authorId', '') != me())
        // +1 only together with a new comment (the comment rule checks the pairing).
        || (onlyChanged(['commentCount']) && request.resource.data.commentCount == resource.data.commentCount + 1
            && stampedNow('lastComment') && waited('lastComment', 15)
            && getAfter(limits()).data.lastCommentId.matches(buildId + '/[A-Za-z0-9]+')
            && existsAfter(/databases/$(database)/documents/builds/$(buildId)/comments/$(getAfter(limits()).data.lastCommentId.split('/')[1])))
        || (resource.data.authorId == me() && onlyChanged(['name', 'description', 'tag'])
            && (!('tag' in request.resource.data) || request.resource.data.tag in ['power', 'fuel', 'chemicals', 'metals', 'early'])
            && str(request.resource.data.name, 1, 64) && clean(request.resource.data.name)
            && str(request.resource.data.description, 0, 2000) && (request.resource.data.description == '' || clean(request.resource.data.description)))
        // After a rename, the author's builds show the new name.
        || (resource.data.authorId == me() && onlyChanged(['author']) && request.resource.data.author == myUsername())
        // The author updates the flow itself (votes, comments and the link stay).
        || (resource.data.authorId == me() && onlyChanged(['flowJson', 'stats', 'updatedAt'])
            && str(request.resource.data.flowJson, 2, 900000)
            && request.resource.data.updatedAt == request.time
            && request.resource.data.stats is map
            && request.resource.data.stats.keys().hasOnly(['machines', 'topTier', 'lowTier', 'eutUse', 'eutGen', 'output'])
            && request.resource.data.stats.machines is number && request.resource.data.stats.eutUse is number && request.resource.data.stats.eutGen is number
            && str(request.resource.data.stats.topTier, 1, 8) && str(request.resource.data.stats.lowTier, 1, 8))
      );
      allow delete: if signedIn() && (resource.data.authorId == me() || isMod()); // moderators remove reported flows

      match /files/{fileId} {
        allow read: if true;
        // Only the author, only a base64 data: URL (never a link to elsewhere or a script URL).
        allow create: if signedIn() && fileId == 'schematic'
          && getAfter(/databases/$(database)/documents/builds/$(buildId)).data.authorId == me()
          && request.resource.data.keys().hasOnly(['name', 'dataUrl'])
          && str(request.resource.data.name, 1, 100)
          && request.resource.data.name.lower().matches('^[^/\\\\<>:"|?*]+\\.(schematic|schem|litematic|nbt)$')
          && str(request.resource.data.dataUrl, 10, 950000)
          // Base64 of gzip data starts "H4sI": schematics are gzip-compressed NBT.
          && request.resource.data.dataUrl.matches('^data:[A-Za-z0-9.+/-]*;base64,H4sI[A-Za-z0-9+/=]+$');
        allow update: if false;
        allow delete: if signedIn() && (get(/databases/$(database)/documents/builds/$(buildId)).data.authorId == me() || isMod());
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['author', 'authorId', 'text', 'createdAt', 'up', 'down', 'parentId'])
          // A reply: to an existing top-level comment on the same build (one level of replies).
          && (!('parentId' in request.resource.data) || (str(request.resource.data.parentId, 1, 64)
              && exists(/databases/$(database)/documents/builds/$(buildId)/comments/$(request.resource.data.parentId))
              && !('parentId' in get(/databases/$(database)/documents/builds/$(buildId)/comments/$(request.resource.data.parentId)).data)))
          && request.resource.data.authorId == me()
          && request.resource.data.author == myUsername()
          && request.resource.data.createdAt == request.time
          && str(request.resource.data.text, 1, 1000) && clean(request.resource.data.text)
          && request.resource.data.up == [] && request.resource.data.down == []
          // Counted on the build in the same write, and at most one comment per 15 seconds.
          && getAfter(/databases/$(database)/documents/builds/$(buildId)).data.commentCount == get(/databases/$(database)/documents/builds/$(buildId)).data.commentCount + 1
          && stampedNow('lastComment') && waited('lastComment', 15)
          && getAfter(limits()).data.lastCommentId == buildId + '/' + commentId;
        // Voting: add your uid to one list (removing it from the other), or take it back.
        // After a rename, the author's comments show the new name.
        allow update: if signedIn() && ((onlyChanged(['up', 'down'])
          && request.resource.data.up is list && request.resource.data.down is list
          && request.resource.data.up.removeAll([me()]) == resource.data.up.removeAll([me()])
          && request.resource.data.down.removeAll([me()]) == resource.data.down.removeAll([me()])
          && !(request.resource.data.up.hasAny([me()]) && request.resource.data.down.hasAny([me()])))
          || (resource.data.authorId == me() && onlyChanged(['author']) && request.resource.data.author == myUsername()));
        allow delete: if signedIn() && (resource.data.authorId == me() || isMod()
          || get(/databases/$(database)/documents/builds/$(buildId)).data.authorId == me());
      }
    }
  }
}

  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "import-recipes": "node scripts/import-recipes.mjs && node scripts/import-recipes.mjs --profile base",
